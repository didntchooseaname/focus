settings-files-history-desc = Before a write replaces a note, its content is kept outside the vault, in the data folder. Versions hold the text as written, secrets included, and are never indexed, exported, or sent to a model or an agent.
settings-files-history-days-label = Keep versions for
settings-files-history-days-desc = Older versions are deleted. Between { $min } and { $max } days.
settings-files-history-size-label = Space limit per vault
settings-files-history-size-desc = The oldest versions are deleted first. Between { $min } and { $max } MB.
settings-files-history-used-label = Space used
settings-files-history-used-desc = Versions kept for this vault.
settings-files-history-clear-label = Delete all versions
settings-files-history-clear-desc = Removes every kept version of every note of this vault. The notes themselves are not touched. This cannot be undone.
settings-files-history-clear-action = Delete
settings-files-history-clear-confirm = Confirm
settings-files-history-clear-failed = The versions could not be deleted. Check the permissions of the history folder.
settings-files-history-cleared = Versions deleted, { $size } freed.
settings-unit-days = days
settings-unit-mb = MB
