ui-merge-what-start = The text of { $source } goes at the start of { $destination }, and its properties join those of { $destination }.
ui-merge-what-new = { $source } becomes the new note { $destination }.
ui-merge-counting = Counting the links…
ui-merge-links =
    { $links ->
        [0] No link leads to it.
        [one] { $links } link will lead to { $destination }.
       *[other] { $links } links will lead to { $destination }.
    }
ui-merge-trash = { $source } goes to the trash of the vault. Both texts stay in the versions of { $destination }.
ui-merge-trash-system = { $source } goes to the system trash, where your file manager can restore it. Both texts stay in the versions of { $destination }.
ui-merge-no-note = Open a note to merge it into another one
ui-note-merged =
    { $links ->
        [one] Note merged into { $destination }. { $links } link rewritten.
       *[other] Note merged into { $destination }. { $links } links rewritten.
    }
ui-extract-no-selection = Select text in a note in Edit or Live to extract it
ui-selection-extracted = Extracted into { $destination }
ui-extract-source-changed = Text added to { $destination }, but the note changed meanwhile: the selection was left in place
vault-tasks-open = Open
vault-tasks-done = Done
vault-tasks-all = All
vault-tasks-empty = No tasks here. A line that starts with - [ ] is a task.
vault-broken-empty = No broken links: every link leads to a note or a file.
vault-broken-total = { $links ->
        [one] 1 broken link
       *[other] { $links } broken links
    } in { $notes ->
        [one] 1 note
       *[other] { $notes } notes
    }
vault-broken-total-files = { $links ->
        [one] 1 broken link
       *[other] { $links } broken links
    } in { $files ->
        [one] 1 file
       *[other] { $files } files
    }
vault-broken-create = Create the note
vault-error-io = Could not read or write { $path }. Check that the file is there and writable.
vault-error-outside = { $path } is outside the vault. Choose a path inside it.
vault-error-exists = { $path } already exists. Choose another name.
vault-error-unknown = This note is no longer in the vault.
vault-error-conflict = { $path } changed on disk. Reload it before saving.
vault-error-other = The vault refused the operation. Check the path and try again.
vault-name-empty = Type a name.
vault-name-forbidden = A name cannot contain { $character }. Windows and Obsidian refuse it.
vault-name-unlinkable = A name cannot contain { $character }: a link could not reach the note.
vault-name-hidden = A name cannot start with a dot: the file would be hidden.
vault-name-dot = A name cannot end with a dot. Windows refuses it.
vault-name-reserved = { $name } is reserved by Windows. Choose another name.
vault-name-long = This name is too long: { $max } bytes at most.
vault-bookmarks = Bookmarks
vault-recent = Recent notes
vault-bookmarks-empty = No bookmarks. Right-click a note in Files to add one.
vault-recent-empty = Notes you open appear here.
vault-bookmark-remove = Remove bookmark
vault-menu-bookmark = Add to bookmarks
vault-menu-unbookmark = Remove from bookmarks
ui-status-conflict = Changed on disk
ui-status-backlinks =
    { $count ->
        [one] { $shown } backlink
       *[other] { $shown } backlinks
    }
ui-status-broken =
    { $count ->
        [one] { $shown } broken link
       *[other] { $shown } broken links
    }
ui-status-index =
    { $count ->
        [one] { $shown } note indexed
       *[other] { $shown } notes indexed
    }
ui-status-agent = Agent connected
ui-status-agent-tip = An agent reached this window through the local socket, last at { $time }.
ui-agent-inserted = An agent inserted { $count ->
    [one] { $count } character
   *[other] { $count } characters
} into { $note }.
ui-address-title = Open this address with another application?
ui-address-why = Focus opens web, mail and telephone addresses directly. This one goes to the application the system has for its scheme.
ui-address-open = Open
ui-address-refused = Address not opened: { $target }
ui-obsidian-refused = Address not followed: Focus does not run { $name }, it calls no address back and has no vault manager
ui-obsidian-unknown = Address not followed: unknown action { $action }
ui-obsidian-malformed = Address not followed: it cannot be read
ui-obsidian-no-vault = Address not followed: open a vault first
ui-obsidian-other-vault = Address not followed: it is for the vault { $vault }, { $open } is open
ui-obsidian-outside = Address not followed: { $path } is outside the vault { $open }
ui-obsidian-not-found = Address not followed: { $target } is not in { $open }
ui-obsidian-heading-missing = Nothing written: { $path } has no heading { $heading }
ui-obsidian-changed = Nothing written: { $path } changed since the confirmation, follow the address again
ui-obsidian-written = Text written to { $path }
ui-obsidian-create-title = Create a note?
ui-obsidian-append-title = Add text at the end of a note?
ui-obsidian-prepend-title = Add text at the start of a note?
ui-obsidian-overwrite-title = Replace the content of a note?
ui-obsidian-why = An obsidian:// address asks to write in this vault. Nothing is written until you confirm.
ui-obsidian-text = Text written
ui-obsidian-empty = An empty note
ui-obsidian-replaces =
    { $lines ->
    [one] It replaces the line the note holds now
    *[other] It replaces the { $lines } lines the note holds now
    }
ui-obsidian-create = Create
ui-obsidian-append = Add
ui-obsidian-prepend = Add
ui-obsidian-overwrite = Replace
vault-imported =
    { $count ->
        [one] Copied { $count } file into { $folder }.
       *[other] Copied { $count } files into { $folder }.
    }
vault-import-cancelled =
    { $count ->
        [one] Copy stopped: { $count } file copied into { $folder }.
       *[other] Copy stopped: { $count } files copied into { $folder }.
    }
vault-import-skip-link =
    { $count ->
        [one] Skipped { $name }: a symbolic link out of what was given.
       *[other] Skipped { $count } items, { $name } first: symbolic links out of what was given, or files that could not be copied.
    }
vault-import-skip-special =
    { $count ->
        [one] Skipped { $name }: a device, socket or pipe.
       *[other] Skipped { $count } items, { $name } first: devices, sockets, pipes or links.
    }
vault-import-skip-failed =
    { $count ->
        [one] Could not copy { $name }.
       *[other] Could not copy { $count } items, { $name } first.
    }
vault-menu-copy = Copy
vault-menu-paste = Paste
vault-copied-file = Copied { $name }
vault-paste-empty = No files on the clipboard.
vault-paste-remote =
    { $count ->
        [one] Only files of this computer can be pasted: { $count } address left out.
       *[other] Only files of this computer can be pasted: { $count } addresses left out.
    }
vault-paste-failed = The clipboard could not be read: { $detail }
ui-status-copying =
    { $count ->
        [one] Copying: { $count } file, { $size }
       *[other] Copying: { $count } files, { $size }
    }
ui-status-copy-cancel = Cancel
ui-status-history = Version history: { $error }
ui-switch-title = Open the vault { $to }?
ui-switch-why = This file belongs to { $to }. The notes of { $from } are saved, then { $from } closes.
ui-switch-open = Open the vault
ui-cmd-split-right = Split right
ui-cmd-focus-other-group = Focus the other tab group
