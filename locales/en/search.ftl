search-ai-failed-balance = DeepSeek balance is insufficient (402). Top up the account.
search-ai-failed-rate-limit = DeepSeek rate limit reached. Try again in { $seconds } s.
search-ai-failed-network = DeepSeek is unreachable. The local results are kept.
search-ai-failed-other = The assistant failed. The local results are kept.
search-replace-toggle = Replace across the vault
search-replace-placeholder = Replace with
search-replace-reading = Reading the notes…
search-replace-summary =
    { $lines ->
        [one] { $lines } line to change in { $files ->
            [one] { $files } note
           *[other] { $files } notes
        }
       *[other] { $lines } lines to change in { $files ->
            [one] { $files } note
           *[other] { $files } notes
        }
    }
search-replace-kept = { $lines } kept in { $files }
search-replace-apply = Apply
search-replace-no-terms = The query has no text to replace.
search-replace-done =
    { $count ->
        [one] Replaced { $count } occurrence in { $files ->
            [one] { $files } note
           *[other] { $files } notes
        }
       *[other] Replaced { $count } occurrences in { $files ->
            [one] { $files } note
           *[other] { $files } notes
        }
    }
search-replace-failed =
    { $count ->
        [one] { $count } note was not written
       *[other] { $count } notes were not written
    }
search-replace-changed = changed on disk since the preview
search-replace-write-error = could not write ({ $detail })
search-replace-failed-note = { $title }: { $reason }
search-replace-unreadable =
    { $count ->
        [one] { $count } note left out: not valid UTF-8
       *[other] { $count } notes left out: not valid UTF-8
    }
