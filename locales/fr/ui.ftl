vault-renamed =
    { $count ->
        [0] Renommé en { $name }. Aucun lien à réécrire.
        [one] Renommé en { $name }. Liens réécrits dans { $count } note.
       *[other] Renommé en { $name }. Liens réécrits dans { $count } notes.
    }
