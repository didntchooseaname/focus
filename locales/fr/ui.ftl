ui-tag-renamed =
    { $notes ->
        [one] Tag #{ $from } renommé en #{ $to } dans { $notes } note
       *[other] Tag #{ $from } renommé en #{ $to } dans { $notes } notes
    }
ui-tag-renamed-partly =
    { $failed ->
        [one] Tag renommé en #{ $to } dans { $notes } notes. { $failed } note est restée telle quelle : { $path }
       *[other] Tag renommé en #{ $to } dans { $notes } notes. { $failed } notes sont restées telles quelles, la première : { $path }
    }
