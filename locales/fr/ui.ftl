    { $count ->
        [one] { $count } fichier copié dans { $folder }.
       *[other] { $count } fichiers copiés dans { $folder }.
    }
vault-import-cancelled =
    { $count ->
        [one] Copie arrêtée : { $count } fichier copié dans { $folder }.
       *[other] Copie arrêtée : { $count } fichiers copiés dans { $folder }.
    }
vault-import-skip-link =
    { $count ->
        [one] { $name } ignoré : un lien symbolique qui sort de ce qui a été donné.
       *[other] { $count } éléments ignorés, dont { $name } : liens symboliques qui sortent de ce qui a été donné, ou fichiers impossibles à copier.
    }
vault-import-skip-special =
    { $count ->
        [one] { $name } ignoré : un périphérique, un socket ou un tube.
       *[other] { $count } éléments ignorés, dont { $name } : périphériques, sockets, tubes ou liens.
    }
