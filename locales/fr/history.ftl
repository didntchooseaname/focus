history-empty-hint = Focus garde le contenu qu'une écriture remplace, au plus toutes les 5 minutes. Modifiez la note, puis revenez.
history-off-hint = L'historique est désactivé. Activez-le dans Réglages, Fichiers et liens.
history-kind-edit = Modification
history-kind-bulk = Changement sur plusieurs notes
history-kind-restore = Avant une restauration
history-kind-external = Écrit par un autre programme
history-kind-unsaved = Votre texte non enregistré
history-kind-reload = Avant un rechargement depuis le disque
history-copy-syncthing = Copie de conflit de Syncthing
history-copy-syncthing-device = Copie de conflit de Syncthing, appareil { $device }
history-copy-obsidian = Copie de conflit d'Obsidian Sync
history-copy-obsidian-device = Copie de conflit d'Obsidian Sync, { $device }
history-tab-changes = Changements
history-tab-rendered = Rendu
history-same = Cette version est identique au texte actuel.
history-copy-same = Cette copie est identique au texte actuel.
history-count-added = ajoutées
history-count-removed = retirées
history-copy = Copier
history-restore = Restaurer
history-copied = Version copiée
history-restored = Version restaurée
history-delete-copy = Supprimer la copie
history-copy-text-copied = Texte de la copie copié
history-copy-restored = Copie restaurée
history-copy-deleted = Copie supprimée
history-folded =
    { $count ->
        [one] { $count } ligne inchangée
       *[other] { $count } lignes inchangées
    }
history-error-unavailable = L'historique de ce coffre n'est pas disponible. Relancez Focus ou vérifiez le dossier de données.
history-error-unknown-note = La note n'est plus dans le coffre.
history-error-gone = Cette version n'existe plus. La liste a été rechargée.
history-error-damaged = La copie stockée de cette version est abîmée et ne peut pas être lue.
history-error-io = L'historique n'a pas pu être lu ou écrit ({ $path }). Vérifiez ses permissions.
history-error-conflict = La note a changé sur le disque. La liste et les changements ont été rechargés : vérifiez-les, puis restaurez de nouveau.
history-error-other = La note n'a pas pu être écrite : { $detail }
