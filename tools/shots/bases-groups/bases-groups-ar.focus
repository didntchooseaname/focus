lang ar
open Board.md
view reading
wait 800
shot bases-groups-ar-embed
scroll 1
wait 300
shot bases-groups-ar-embed-end
scroll 0
wait 300
click work table
wait 800
shot bases-groups-ar-page
right outline
wait 300
shot bases-groups-ar-page-outline
click #fold 1
wait 300
shot bases-groups-ar-page-folded
goto todo
wait 300
shot bases-groups-ar-page-goto
open Board.md
wait 300
click other views
wait 800
shot bases-groups-ar-views
goto Same status
wait 300
shot bases-groups-ar-views-this
open Today.md
wait 800
shot bases-groups-ar-this-embed
quit
